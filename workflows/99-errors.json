      "name": "ERROR ROW",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "const err = $('FORMAT ERROR').first().json;\nconst rows = $input.all().map((i) => i.json).filter((r) => r.youtube_id);\nif (!rows.length) return [];\nreturn rows.map((r) => ({ json: {\n  youtube_id: r.youtube_id, status: 'ERROR',\n  error_reason: `${err.error_code} @ ${err.step}: ${err.error_message}`.slice(0, 500),\n  updated_at: new Date().toISOString(),\n} }));"
      }
    },
