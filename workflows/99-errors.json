      "name": "FORMAT ERROR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Normalizes the failed execution into the error log row (docs/plan.md §32). Never logs secrets.\nconst e = $input.first().json;\nconst msg = String(e.execution?.error?.message ?? 'unknown error');\nconst step = e.execution?.lastNodeExecuted ?? '';\nlet code = (msg.match(/^([A-Z][A-Z0-9_]{3,}):/) || [])[1];\nif (!code && /YOUTUBE/.test(step)) code = /token|auth|credential|401|403|invalid_grant/i.test(msg) ? 'YOUTUBE_AUTH_FAILED' : 'YOUTUBE_UPLOAD_FAILED';\nif (!code && /READ MP4/.test(step)) code = 'VIDEO_DOWNLOAD_FAILED';\nif (!code && /dataTable|MARK|LOOKUP|ENSURE/i.test(step)) code = 'DATABASE_FAILED';\ncode = code ?? 'UNHANDLED';\nreturn [{ json: {\n  execution_id: String(e.execution?.id ?? ''),\n  workflow: e.workflow?.name ?? '',\n  step,\n  error_code: code,\n  error_message: msg.replace(/(Bearer|api[_-]?key|token|secret)[^\\s,]*\\s*[:=]?\\s*\\S+/gi, '$1 [redacted]').slice(0, 1000),\n  execution_url: e.execution?.url ?? '',\n  timestamp: new Date().toISOString(),\n} }];"
      }
    },
    {
      "id": "x3",
      "name": "ENSURE ERRORS TABLE",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
