TZ=America/Sao_Paulo

# Required. Encrypts n8n credentials. Generate with: openssl rand -hex 32
# Never lose it: without it, stored credentials can't be decrypted.
N8N_ENCRYPTION_KEY=

VIZARD_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: also expose n8n on this Tailscale IP
TAILSCALE_IP=

# Storage (default: ./downloads and ./backups)
DOWNLOADS_DIR=
BACKUP_DIR=

# LLM bridge (bridge/server.mjs): uses local Claude Code / Codex logins, no API keys
# Generate with: openssl rand -hex 32
LLM_BRIDGE_TOKEN=
LLM_BRIDGE_PORT=8787

# Local clipper (clipper/server.py), same token as the LLM bridge
CLIPPER_PORT=8788
